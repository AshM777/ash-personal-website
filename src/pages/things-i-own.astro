---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
---

<PageLayout title="Things I Own" description="Tools and gear I use daily">
  <Container>
    <div class="flex flex-col items-center justify-center min-h-[60vh] space-y-6 animate">
      <div class="text-center space-y-4">
        <h1 class="text-4xl font-semibold text-black dark:text-white">
          Things I Own
        </h1>
        <div class="inline-block px-4 py-2 rounded-full bg-[var(--accent-soft)] text-[var(--accent)] font-semibold text-sm uppercase tracking-wide">
          Coming Soon!
        </div>
        <p class="text-lg text-black dark:text-white max-w-md mx-auto">
          I'm curating a list of tools and gear I use daily. Check back soon!
        </p>
      </div>
    </div>
  </Container>
</PageLayout>
