---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";

const portfolioItems = await getCollection("portfolio");

// Group items by category and sort by order
type PortfolioItem = typeof portfolioItems[number];
const groupedItems = portfolioItems.reduce((acc, item) => {
  const category = item.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(item);
  return acc;
}, {} as Record<string, PortfolioItem[]>);

// Sort items within each category by order
Object.keys(groupedItems).forEach(category => {
  groupedItems[category].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
});

function getGridClasses(size: string) {
  switch (size) {
    case 'large':
      return 'col-span-2 row-span-2';
    case 'wide':
      return 'col-span-2 row-span-1';
    case 'tall':
      return 'col-span-1 row-span-2';
    default:
      return 'col-span-1 row-span-1';
  }
}
---

<PageLayout title="Portfolio" description="A collection of my work, research, and writing">
  <Container>
    <div class="space-y-20">
      {Object.entries(groupedItems).map(([category, items]) => (
        <section class="space-y-6">
          <div class="animate text-xs font-semibold uppercase tracking-[0.2em] text-black/60 dark:text-white/60">
            {category}
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 auto-rows-[120px] md:auto-rows-[140px]">
            {items.map((item, index) => {
              const itemData = item.data;
              let sizeClasses = 'md:col-span-1 md:row-span-1';
              if (itemData.size === 'large') {
                sizeClasses = 'md:col-span-2 md:row-span-2';
              } else if (itemData.size === 'wide') {
                sizeClasses = 'md:col-span-2 md:row-span-1';
              } else if (itemData.size === 'tall') {
                sizeClasses = 'md:col-span-1 md:row-span-2';
              }
              
              return (
                <a
                  href={itemData.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`group relative col-span-2 overflow-hidden rounded-xl border border-black/10 dark:border-white/10 bg-white/50 dark:bg-black/20 hover:border-black/20 dark:hover:border-white/20 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 animate ${sizeClasses}`}
                  style={`animation-delay: ${index * 50}ms`}
                >
                  {itemData.image ? (
                    <>
                      <img
                        src={itemData.image}
                        alt={itemData.title}
                        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <div class="absolute bottom-0 left-0 right-0 p-4">
                          <div class="text-white">
                            <div class="font-semibold text-sm md:text-base line-clamp-2">{itemData.title}</div>
                            <div class="mt-1 text-xs opacity-90 line-clamp-1">{itemData.description}</div>
                          </div>
                        </div>
                      </div>
                    </>
                  ) : itemData.images && itemData.images.length > 0 ? (
                    <>
                      <div class="grid grid-cols-2 h-full gap-0.5">
                        {itemData.images.slice(0, 4).map((img, idx) => (
                          <div class="overflow-hidden">
                            <img
                              src={img}
                              alt={`${itemData.title} ${idx + 1}`}
                              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                              loading="lazy"
                            />
                          </div>
                        ))}
                      </div>
                      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <div class="absolute bottom-0 left-0 right-0 p-4">
                          <div class="text-white">
                            <div class="font-semibold text-sm md:text-base line-clamp-2">{itemData.title}</div>
                            <div class="mt-1 text-xs opacity-90 line-clamp-1">{itemData.description}</div>
                          </div>
                        </div>
                      </div>
                    </>
                  ) : (
                    <div class="h-full w-full flex flex-col justify-between p-4 md:p-5 bg-gradient-to-br from-black/5 via-black/5 to-black/10 dark:from-white/5 dark:via-white/5 dark:to-white/10 group-hover:from-black/10 group-hover:to-black/15 dark:group-hover:from-white/10 dark:group-hover:to-white/15 transition-all duration-300">
                      <div class="flex-1"></div>
                      <div class="space-y-2">
                        <div class="font-semibold text-sm md:text-base text-black dark:text-white line-clamp-2 group-hover:text-black dark:group-hover:text-white">
                          {itemData.title}
                        </div>
                        <div class="text-xs text-black/60 dark:text-white/60 line-clamp-1">
                          {itemData.description}
                        </div>
                        <div class="text-xs text-black/40 dark:text-white/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                          visit →
                        </div>
                      </div>
                    </div>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </Container>
</PageLayout>

<style>
  @media (min-width: 768px) {
    .md\:col-span-2 {
      grid-column: span 2 / span 2;
    }
    .md\:row-span-2 {
      grid-row: span 2 / span 2;
    }
  }
  
  .group:hover img {
    will-change: transform;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate {
    animation: fadeInUp 0.6s ease-out backwards;
  }
</style>
