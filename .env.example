# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
EMAIL_FROM=your-name@example.com

# Site Configuration
SITE_URL=http://localhost:3000

# Admin Configuration - Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_ALLOWED_EMAILS=your-email@gmail.com

# GitHub Configuration (for admin content management)
GITHUB_REPO=AshM777/ash-personal-website-vercel
GITHUB_TOKEN=your-github-token
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=src/content 